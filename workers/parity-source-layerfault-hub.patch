+fn ablitbench_hub_broker_endpoint() -> Result<Option<Url>> {
+    let Some(raw) = std::env::var_os("ABLIB_HUB_BROKER_ENDPOINT") else {
+        return Ok(None);
+    };
+    let raw = raw.to_str().ok_or_else(|| anyhow!("invalid broker endpoint encoding"))?;
+    let endpoint = Url::parse(raw).context("invalid broker endpoint URL")?;
+    if endpoint.scheme() != "http"
+        || endpoint.host_str() != Some("127.0.0.1")
+        || endpoint.port().is_none_or(|port| port == 0)
+        || !endpoint.username().is_empty()
+        || endpoint.password().is_some()
+        || endpoint.query().is_some()
+        || endpoint.fragment().is_some()
+        || endpoint.path() != "/hub"
+    {
+        bail!("Hub broker requires its exact private loopback endpoint");
+    }
+    Ok(Some(endpoint))
+}
